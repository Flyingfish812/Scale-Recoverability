#=============================================================================
# Luna — .gitignore
#
# This repository holds the code that accompanies the paper. It carries the
# runtime code and the reproducibility inputs only; intermediate products,
# large binaries and the paper sources live outside version control.
#=============================================================================

#---------------------------------------------------------------------------
# Generated products and run outputs
#---------------------------------------------------------------------------
artifacts/
artifacts_*
_legacy/
data/*.npy
# local working notes under data/ (data-provenance reports and similar)
data/*.md
# the manuscript is kept in its own directory
# (thesis_src_planA/ and thesis_src_planB/ are local writing copies)
thesis_work/
/figures/
/results/
/logs/
environment/*
!environment/environment.yml
draft.txt
thesis
references
*.tar.gz

#---------------------------------------------------------------------------
# Output written next to the scripts under applications/
# The figures/ and tables/ directories also contain the plotting code, so they
# cannot be ignored as a whole: generated files are excluded by extension and
# the build/ directory is excluded as a whole.
#---------------------------------------------------------------------------
applications/**/results/
applications/**/reports/
applications/**/build/
applications/**/figures/*.pdf
applications/**/figures/*.png
applications/**/figures/*.jpg
applications/**/tables/*.tex
applications/**/tables/*.csv

#---------------------------------------------------------------------------
# Python bytecode and build products
#---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.pytype/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/

# IDE and editor settings
.vscode/
.idea/

# OS and backup files
.DS_Store
Thumbs.db
*~

# Logs and temporary files
*.log
*.tmp
*.temp

# Training checkpoints and intermediate arrays
*.pt
*.ckpt
*.npz

# Internal working documents
agent-docs/
# separate clone of another repository, not part of this code base
paper-writing-skill/
.github/skills/

# Sensor masks, data directories and local catalogues (generated locally)
/masks/
/masks2/
/masks_expand/
/masks_families/
/data_catalog/
/notebooks/
/results*/
/figures_expand/

# Local tooling and the retired orchestration layer
/tools/
/tools_active/
/pipelines/

# The applications/ layer is published in full: applications/pipelines (steps
# 01--05), applications/statistics (one producer per statistic) and
# applications/figures (one script per figure). Generated files below those
# directories are still excluded by extension (see above).

# Remaining large binaries, excluded by extension
*.nc
*.h5
*.hdf5
*.mat
*.onnx
*.pth
